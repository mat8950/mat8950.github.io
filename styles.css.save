@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap');

:root {
    --bg-primary: #000000;
    --bg-secondary: rgba(0, 0, 0, 0.85);
    --bg-tertiary: rgba(10, 10, 10, 0.9);
    --bg-terminal: #000000;
    --bg-glass: rgba(0, 0, 0, 0.7);
    --text-primary: #ffffff;
    --text-secondary: #cccccc;
    --text-dim: #888888;
    --text-highlight: #ffffff;
    --text-muted: #666666;
    --accent: #ffffff;
    --accent-secondary: #aaaaaa;
    --accent-dim: #555555;
    --border-color: rgba(255, 255, 255, 0.1);
    --border-bright: rgba(255, 255, 255, 0.25);
    --border-strong: rgba(255, 255, 255, 0.4);
    --glow-white: 0 0 20px rgba(255, 255, 255, 0.1);
    --sidebar-width: 280px;
    --font-mono: 'Fira Code', 'JetBrains Mono', 'SF Mono', 'Consolas', monospace;
}

/* Mode clair (par défaut le site est sombre) */
body.light-mode {
    --bg-primary: #ffffff;
    --bg-secondary: rgba(255, 255, 255, 0.95);
    --bg-tertiary: rgba(250, 250, 250, 0.95);
    --bg-terminal: #ffffff;
    --bg-glass: rgba(255, 255, 255, 0.9);
    --text-primary: #000000;
    --text-secondary: #222222;
    --text-dim: #555555;
    --text-highlight: #000000;
    --text-muted: #888888;
    --accent: #000000;
    --accent-secondary: #444444;
    --accent-dim: #999999;
    --border-color: rgba(0, 0, 0, 0.15);
    --border-bright: rgba(0, 0, 0, 0.25);
    --border-strong: rgba(0, 0, 0, 0.4);
    --glow-white: 0 0 20px rgba(0, 0, 0, 0.08);
}

/* Fond 3D en mode clair - traits plus visibles */
body.light-mode #bg-canvas {
    filter: invert(1) contrast(3);
    opacity: 0.9;
}

body.light-mode #css-fallback-bg {
    background: #ffffff;
}

body.light-mode .grid-lines {
    background-image:
        linear-gradient(to right, rgba(0, 0, 0, 0.5) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0, 0, 0, 0.5) 1px, transparent 1px);
}

body.light-mode .particle {
    background: #000 !important;
    opacity: 0.8;
}

body.light-mode .v-line {
    background: linear-gradient(to top, transparent, rgba(0, 0, 0, 0.8), transparent) !important;
}

/* Bordures plus discrètes en mode clair */
body.light-mode .sidebar {
    border-color: rgba(0, 0, 0, 0.05);
}

body.light-mode .sidebar h2 {
    border-bottom-color: rgba(0, 0, 0, 0.05);
}

body.light-mode .bookmark-card {
    border-bottom-color: rgba(0, 0, 0, 0.05);
}

body.light-mode .folder-item {
    border-left-color: transparent;
}

body.light-mode .folder-item:hover,
body.light-mode .folder-item.active {
    background: rgba(0, 0, 0, 0.03);
    border-left-color: #000;
}

body.light-mode header {
    border-bottom-color: rgba(0, 0, 0, 0.05);
}

/* Barre de recherche mode clair */
body.light-mode #search {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(0, 0, 0, 0.15);
    color: #000;
}

body.light-mode #search::placeholder {
    color: #888;
}

body.light-mode #search:focus {
    background: #fff;
    border-color: rgba(0, 0, 0, 0.3);
}

/* Hover bookmarks mode clair */
body.light-mode .bookmark-card:hover {
    background: rgba(0, 0, 0, 0.05);
}

body.light-mode .bookmark-card:hover::before,
body.light-mode .bookmark-card:hover .bookmark-title,
body.light-mode .bookmark-card:hover::after {
    color: #000;
}

body.light-mode .bookmark-card:hover .bookmark-url {
    color: rgba(0, 0, 0, 0.6);
}

/* Audio controls en mode clair - pas de rectangle noir */
body.light-mode .audio-controls {
    background: transparent;
}

body.light-mode #audio-toggle {
    background: rgba(0, 0, 0, 0.05);
    border-color: rgba(0, 0, 0, 0.2);
    color: #000;
}

body.light-mode #audio-toggle:hover {
    background: rgba(0, 0, 0, 0.1);
}

body.light-mode #audio-toggle.playing {
    background: rgba(0, 0, 0, 0.1);
    border-color: rgba(0, 0, 0, 0.3);
}

/* ===== THEME: APPLE DARK ===== */
body[data-theme="apple-dark"] {
    --bg-primary: #000000;
    --bg-secondary: rgba(28, 28, 30, 0.9);
    --bg-tertiary: rgba(44, 44, 46, 0.9);
    --bg-terminal: #000000;
    --bg-glass: rgba(28, 28, 30, 0.85);
    --text-primary: #ffffff;
    --text-secondary: rgba(255, 255, 255, 0.85);
    --text-dim: rgba(255, 255, 255, 0.55);
    --text-highlight: #ffffff;
    --text-muted: rgba(255, 255, 255, 0.35);
    --accent: #2997ff;
    --accent-secondary: #0071e3;
    --accent-dim: rgba(41, 151, 255, 0.3);
    --border-color: rgba(255, 255, 255, 0.08);
    --border-bright: rgba(255, 255, 255, 0.16);
    --border-strong: rgba(255, 255, 255, 0.24);
    --glow-white: 0 3px 30px rgba(0, 0, 0, 0.22);
    --font-mono: -apple-system, 'SF Pro Text', 'Helvetica Neue', Arial, sans-serif;
}

/* ===== THEME: APPLE LIGHT ===== */
body[data-theme="apple-light"] {
    --bg-primary: #f5f5f7;
    --bg-secondary: rgba(255, 255, 255, 0.95);
    --bg-tertiary: rgba(255, 255, 255, 0.9);
    --bg-terminal: #f5f5f7;
    --bg-glass: rgba(255, 255, 255, 0.85);
    --text-primary: #1d1d1f;
    --text-secondary: rgba(0, 0, 0, 0.8);
    --text-dim: rgba(0, 0, 0, 0.55);
    --text-highlight: #1d1d1f;
    --text-muted: rgba(0, 0, 0, 0.42);
    --accent: #0071e3;
    --accent-secondary: #0066cc;
    --accent-dim: rgba(0, 113, 227, 0.12);
    --border-color: rgba(0, 0, 0, 0.07);
    --border-bright: rgba(0, 0, 0, 0.12);
    --border-strong: rgba(0, 0, 0, 0.2);
    --glow-white: 0 3px 30px rgba(0, 0, 0, 0.06);
    --font-mono: -apple-system, 'SF Pro Text', 'Helvetica Neue', Arial, sans-serif;
}

/* ===== THEME: NORD ===== */
body[data-theme="nord"] {
    --bg-primary: #2e3440;
    --bg-secondary: rgba(46, 52, 64, 0.95);
    --bg-tertiary: rgba(59, 66, 82, 0.95);
    --bg-terminal: #2e3440;
    --bg-glass: rgba(46, 52, 64, 0.85);
    --text-primary: #eceff4;
    --text-secondary: #e5e9f0;
    --text-dim: #d8dee9;
    --text-highlight: #eceff4;
    --text-muted: #81a1c1;
    --accent: #88c0d0;
    --accent-secondary: #81a1c1;
    --accent-dim: rgba(136, 192, 208, 0.2);
    --border-color: rgba(236, 239, 244, 0.08);
    --border-bright: rgba(236, 239, 244, 0.14);
    --border-strong: rgba(136, 192, 208, 0.4);
    --glow-white: 0 0 20px rgba(136, 192, 208, 0.1);
    --font-mono: 'Fira Code', 'JetBrains Mono', 'SF Mono', monospace;
}

/* ===== THEME: DRACULA ===== */
body[data-theme="dracula"] {
    --bg-primary: #282a36;
    --bg-secondary: rgba(40, 42, 54, 0.95);
    --bg-tertiary: rgba(68, 71, 90, 0.95);
    --bg-terminal: #282a36;
    --bg-glass: rgba(40, 42, 54, 0.85);
    --text-primary: #f8f8f2;
    --text-secondary: #e2e0d8;
    --text-dim: #bd93f9;
    --text-highlight: #f8f8f2;
    --text-muted: #6272a4;
    --accent: #ff79c6;
    --accent-secondary: #bd93f9;
    --accent-dim: rgba(255, 121, 198, 0.15);
    --border-color: rgba(248, 248, 242, 0.08);
    --border-bright: rgba(248, 248, 242, 0.14);
    --border-strong: rgba(255, 121, 198, 0.4);
    --glow-white: 0 0 20px rgba(189, 147, 249, 0.15);
    --font-mono: 'Fira Code', 'JetBrains Mono', 'SF Mono', monospace;
}

/* Apple-light : ajustements canvas (même traitement que light-mode) */
body[data-theme="apple-light"] #bg-canvas {
    filter: invert(1) contrast(3);
    opacity: 0.9;
}
body[data-theme="apple-light"] #css-fallback-bg { background: #f5f5f7; }
body[data-theme="apple-light"] .grid-lines {
    background-image:
        linear-gradient(to right, rgba(0, 0, 0, 0.5) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0, 0, 0, 0.5) 1px, transparent 1px);
}
body[data-theme="apple-light"] .particle { background: #000 !important; opacity: 0.8; }
body[data-theme="apple-light"] .v-line {
    background: linear-gradient(to top, transparent, rgba(0, 0, 0, 0.8), transparent) !important;
}

/* Apple-light : hover bookmarks (override hardcoded #fff) */
body[data-theme="apple-light"] .bookmark-card:hover { background: rgba(0, 0, 0, 0.04); }
body[data-theme="apple-light"] .bookmark-card:hover::before,
body[data-theme="apple-light"] .bookmark-card:hover .bookmark-title,
body[data-theme="apple-light"] .bookmark-card:hover::after { color: var(--text-primary); }
body[data-theme="apple-light"] .bookmark-card:hover .bookmark-url { color: rgba(0, 0, 0, 0.6); opacity: 1; }
body[data-theme="apple-light"] .folder-item:hover,
body[data-theme="apple-light"] .folder-item.active { background: rgba(0, 0, 0, 0.03); border-left-color: #1d1d1f; }
body[data-theme="apple-light"] .folder-card:hover { background: rgba(0, 0, 0, 0.03); }
body[data-theme="apple-light"] .folder-card:hover::before,
body[data-theme="apple-light"] .folder-card:hover .folder-name { color: var(--text-primary); }
body[data-theme="apple-light"] #search { background: rgba(255, 255, 255, 0.9); border-color: rgba(0, 0, 0, 0.15); color: #1d1d1f; }
body[data-theme="apple-light"] #search::placeholder { color: rgba(0, 0, 0, 0.4); }
body[data-theme="apple-light"] .sidebar { border-color: rgba(0, 0, 0, 0.05); }
body[data-theme="apple-light"] #audio-toggle { background: rgba(0, 0, 0, 0.05); border-color: rgba(0, 0, 0, 0.2); color: #1d1d1f; }
body[data-theme="apple-light"] .audio-controls { background: transparent; }
body[data-theme="apple-light"] :focus-visible { outline-color: #0071e3; }

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Accessibilité - masquer visuellement mais garder pour lecteurs d'écran */
.visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

/* Focus visible amélioré */
:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
}

body.light-mode :focus-visible {
    outline-color: #000;
}

/* Skip link pour accessibilité clavier */
.skip-link {
    position: absolute;
    top: -40px;
    left: 0;
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: 8px;
    z-index: 10000;
    text-decoration: none;
}

.skip-link:focus {
    top: 0;
}

html {
    font-size: 14px;
}

body {
    font-family: var(--font-mono);
    background: var(--bg-terminal);
    color: var(--text-primary);
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
    line-height: 1.6;
}

/* ===== 3D BACKGROUND CANVAS ===== */
#bg-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
}

/* ===== SUBTLE NOISE OVERLAY ===== */
body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    opacity: 0.03;
    pointer-events: none;
    z-index: 9999;
}

/* ===== ANIMATIONS ===== */
@keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateX(-10px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
}

@keyframes typing {
    from { width: 0; }
    to { width: 100%; }
}

@keyframes folderOpen {
    0% { transform: scale(1); }
    50% { transform: scale(1.1) rotate(-5deg); }
    100% { transform: scale(1); }
}

/* ===== AUDIO CONTROLS ===== */
#audio-controls {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--bg-glass);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--border-color);
    padding: 0.5rem 0.75rem;
    font-size: 0.7rem;
    color: var(--text-dim);
}

#audio-controls::before {
    content: '♪';
    color: var(--text-primary);
    font-size: 0.85rem;
}

#audio-toggle {
    background: transparent;
    border: 1px solid var(--border-bright);
    color: var(--text-secondary);
    padding: 0.3rem 0.6rem;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    transition: all 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
}

#audio-toggle:hover {
    border-color: var(--text-primary);
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
}

#audio-toggle.playing {
    color: var(--text-primary);
    border-color: var(--text-primary);
    background: rgba(255, 255, 255, 0.1);
}

#volume-slider {
    width: 50px;
    height: 2px;
    -webkit-appearance: none;
    appearance: none;
    background: var(--border-bright);
    outline: none;
    cursor: pointer;
}

#volume-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 8px;
    height: 8px;
    background: var(--text-primary);
    cursor: pointer;
}

/* ===== HEADER ===== */
header {
    background: var(--bg-glass);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-color);
    padding: 0.75rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
}

header h1 {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: 2px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    overflow: hidden;
}

header h1 span {
    display: inline-block;
    animation: typing 0.8s steps(12) forwards;
    overflow: hidden;
    white-space: nowrap;
}

header h1::before {
    content: '>';
    color: var(--text-dim);
    font-weight: 400;
}

header h1::after {
    content: '_';
    animation: blink 1s infinite;
    color: var(--text-primary);
    font-weight: 300;
}

.header-controls {
    display: flex;
    gap: 0.75rem;
    align-items: center;
}

#search {
    padding: 0.5rem 1rem;
    border: 1px solid var(--border-bright);
    background: rgba(0, 0, 0, 0.5);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    width: 220px;
    outline: none;
    transition: all 0.2s ease;
}

#search::placeholder {
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
}

#search:focus {
    border-color: var(--text-primary);
    background: rgba(0, 0, 0, 0.7);
}

/* ===== THEME SELECTOR ===== */
.theme-selector {
    position: relative;
    z-index: 200;
}

#theme-selector-btn {
    background: transparent;
    border: 1px solid var(--border-bright);
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    transition: all 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
}

#theme-selector-btn:hover {
    border-color: var(--text-primary);
    color: var(--text-primary);
}

#theme-selector-btn .btn-swatch {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 1px solid currentColor;
    opacity: 0.7;
}

.theme-panel {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background: var(--bg-glass);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--border-bright);
    z-index: 500;
    min-width: 150px;
    padding: 0.25rem 0;
    animation: slideUp 0.15s ease;
}

.theme-panel.open {
    display: flex;
    flex-direction: column;
}

.theme-option {
    background: transparent;
    border: none;
    padding: 0.45rem 0.7rem;
    cursor: pointer;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-align: left;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transition: background 0.1s ease, color 0.1s ease;
    width: 100%;
}

.theme-option:hover {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-primary);
}

.theme-option.active {
    color: var(--text-primary);
}

.theme-option.active::after {
    content: '✓';
    margin-left: auto;
    font-size: 0.6rem;
    opacity: 0.7;
}

.theme-swatch {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
}

.theme-option[data-theme="dark"] .theme-swatch        { background: #111111; border: 1px solid #555555; }
.theme-option[data-theme="light"] .theme-swatch       { background: #f0f0f0; border: 1px solid #999999; }
.theme-option[data-theme="apple-dark"] .theme-swatch  { background: #1c1c1e; border: 1px solid #2997ff; }
.theme-option[data-theme="apple-light"] .theme-swatch { background: #f5f5f7; border: 1px solid #0071e3; }
.theme-option[data-theme="nord"] .theme-swatch        { background: #2e3440; border: 1px solid #88c0d0; }
.theme-option[data-theme="dracula"] .theme-swatch     { background: #282a36; border: 1px solid #ff79c6; }

/* Override hover bg pour options de thème clair (panel reste sombre) */
body[data-theme="apple-light"] .theme-option:hover,
body.light-mode .theme-option:hover { background: rgba(0, 0, 0, 0.05); }

/* ===== MAIN CONTAINER ===== */
.container {
    display: flex;
    min-height: calc(100vh - 52px);
    position: relative;
    z-index: 1;
}

/* ===== SIDEBAR ===== */
.sidebar {
    width: var(--sidebar-width);
    background: var(--bg-glass);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-right: 1px solid var(--border-color);
    padding: 1.5rem 1.25rem;
    overflow-y: auto;
    height: calc(100vh - 52px);
    position: sticky;
    top: 0;
}

.sidebar h2 {
    font-size: 0.65rem;
    margin-bottom: 1.25rem;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 3px;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
}

#folder-tree {
    display: flex;
    flex-direction: column;
    gap: 1px;
}

.folder-item {
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    transition: all 0.15s ease;
    color: var(--text-secondary);
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: transparent;
    border: none;
    border-left: 2px solid transparent;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.folder-item::before {
    content: '—';
    color: var(--text-muted);
    font-size: 0.7rem;
    transition: all 0.2s ease;
}

/* Animation icône dossier ouvert/fermé */
.folder-item.expanded::before {
    content: '▼';
    font-size: 0.5rem;
    transform: rotate(0deg);
}

.folder-item.has-children:not(.expanded)::before {
    content: '▶';
    font-size: 0.5rem;
}

.folder-item:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.03);
    border-left-color: var(--text-primary);
}

.folder-item.active {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
    border-left-color: var(--text-primary);
}

.folder-item.active::after {
    content: '←';
    color: var(--text-primary);
    margin-left: auto;
    font-size: 0.65rem;
}

.folder-item .icon {
    display: none;
}

.folder-item.has-children::after {
    content: '+';
    color: var(--text-muted);
    margin-left: auto;
    font-size: 0.65rem;
}

.folder-item.has-children.expanded::after {
    content: '−';
}

.folder-item.has-children.active::after {
    content: '←';
}

/* Sélection clavier */
.folder-item.keyboard-selected {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.08);
    border-left-color: var(--text-primary);
    outline: 1px solid var(--text-primary);
    outline-offset: -1px;
}

body.light-mode .folder-item.keyboard-selected {
    background: rgba(0, 0, 0, 0.08);
    outline-color: #000;
}

.folder-children {
    margin-left: 1rem;
    display: none;
    flex-direction: column;
    gap: 1px;
    border-left: 1px solid var(--border-color);
    padding-left: 0.75rem;
    margin-top: 2px;
    overflow: hidden;
}

.folder-children.show {
    display: flex;
    animation: slideDown 0.25s ease-out;
}

@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ===== CONTENT AREA ===== */
.content {
    flex: 1;
    padding: 1.5rem 2rem;
    overflow-y: auto;
    position: relative;
    background: transparent;
}

/* ===== BREADCRUMB ===== */
#breadcrumb {
    display: flex;
    gap: 0;
    align-items: center;
    margin-bottom: 1.5rem;
    font-size: 0.7rem;
    color: var(--text-muted);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border-color);
    text-transform: uppercase;
    letter-spacing: 1px;
}

#breadcrumb::before {
    content: 'PATH';
    color: var(--text-muted);
    margin-right: 1rem;
    opacity: 0.5;
}

.breadcrumb-item {
    cursor: pointer;
    transition: all 0.2s ease;
    color: var(--text-secondary);
}

.breadcrumb-item:hover {
    color: var(--text-primary);
}

.breadcrumb-separator {
    color: var(--text-muted);
    margin: 0 0.4rem;
    opacity: 0.3;
}

.breadcrumb-separator::before {
    content: '/';
}

/* ===== OUTPUT HEADER ===== */
#bookmarks-grid::before {
    content: 'INDEX';
    display: block;
    color: var(--text-muted);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color);
    font-size: 0.6rem;
    letter-spacing: 3px;
    text-transform: uppercase;
}

/* ===== BOOKMARKS LIST ===== */
#bookmarks-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
    animation: fadeInContent 0.3s ease;
}

@keyframes fadeInContent {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

#bookmarks-grid.transitioning {
    opacity: 0;
    transition: opacity 0.15s ease;
}

/* ===== BOOKMARK ITEM ===== */
.bookmark-card {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border-color);
    padding: 1.2rem 0;
    cursor: pointer;
    transition: all 0.15s ease;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    position: relative;
}

.bookmark-card::before {
    content: '○';
    color: var(--text-muted);
    font-size: 0.5rem;
    min-width: 20px;
    text-align: center;
}

.bookmark-card:hover {
    background: rgba(255, 255, 255, 0.08);
}

.bookmark-card:hover::before {
    content: '●';
    color: #fff;
}

.bookmark-card:hover .bookmark-title {
    color: #fff;
}

.bookmark-card:hover .bookmark-url {
    color: rgba(255, 255, 255, 0.7);
    opacity: 1;
}

.bookmark-card:hover::after {
    content: '→';
    color: #fff;
    position: absolute;
    right: 0;
    font-size: 0.75rem;
}

/* Sélection clavier bookmark */
.bookmark-card.keyboard-selected {
    background: rgba(255, 255, 255, 0.1);
    outline: 1px solid var(--text-primary);
    outline-offset: -1px;
}

.bookmark-card.keyboard-selected::before {
    content: '●';
    color: #fff;
}

.bookmark-card.keyboard-selected .bookmark-title {
    color: #fff;
}

body.light-mode .bookmark-card.keyboard-selected {
    background: rgba(0, 0, 0, 0.08);
    outline-color: #000;
}

body.light-mode .bookmark-card.keyboard-selected::before {
    color: #000;
}

body.light-mode .bookmark-card.keyboard-selected .bookmark-title {
    color: #000;
}

.bookmark-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    opacity: 0.8;
    transition: all 0.2s ease;
    font-size: 0.9rem;
}

.bookmark-icon img {
    width: 28px;
    height: 28px;
    object-fit: contain;
    background: rgba(255, 255, 255, 0.7);
    border-radius: 4px;
    padding: 3px;
}

.bookmark-card:hover .bookmark-icon {
    opacity: 1;
}

/* Bouton favori */
.favorite-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    color: var(--text-muted);
    padding: 0.25rem 0.5rem;
    transition: all 0.2s ease;
    opacity: 0.3;
    margin-left: auto;
}

.favorite-btn:hover {
    opacity: 1;
    color: gold;
    transform: scale(1.2);
}

.favorite-btn.active {
    opacity: 1;
    color: gold;
}

.bookmark-card:hover .favorite-btn {
    opacity: 0.7;
}

/* Section favoris */
.favorites-section {
    grid-column: 1 / -1;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
}

.favorites-header {
    color: gold;
    font-size: 0.7rem;
    letter-spacing: 2px;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 215, 0, 0.2);
}

.favorites-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
}

.favorites-grid .bookmark-card {
    border-bottom: 1px solid rgba(255, 215, 0, 0.1);
}

.favorites-grid .bookmark-card:last-child {
    border-bottom: none;
}

body.light-mode .favorites-header {
    color: #b8860b;
    border-bottom-color: rgba(184, 134, 11, 0.3);
}

body.light-mode .favorites-grid .bookmark-card {
    border-bottom-color: rgba(184, 134, 11, 0.1);
}

body.light-mode .favorite-btn:hover,
body.light-mode .favorite-btn.active {
    color: #b8860b;
}

/* Lazy loading indicator */
.lazy-loader {
    grid-column: 1 / -1;
    text-align: center;
    padding: 1.5rem;
    color: var(--text-muted);
    font-size: 0.7rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
}

.bookmark-info {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 2rem;
}

.bookmark-title {
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--text-secondary);
    font-size: 0.8rem;
    transition: all 0.15s ease;
    min-width: 200px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.bookmark-url {
    font-size: 0.65rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
    opacity: 0.5;
}

/* ===== FOLDER ITEM ===== */
.folder-card {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border-color);
    padding: 0.75rem 0;
    cursor: pointer;
    transition: all 0.15s ease;
    display: flex;
    align-items: center;
    gap: 1.5rem;
}

.folder-card::before {
    content: '□';
    color: var(--text-muted);
    font-size: 0.6rem;
    min-width: 20px;
    text-align: center;
    transition: all 0.2s ease;
}

.folder-card:hover {
    background: rgba(255, 255, 255, 0.02);
}

.folder-card:hover::before {
    content: '■';
    color: var(--text-primary);
    animation: folderOpen 0.3s ease;
}

.folder-card:hover .folder-name {
    color: var(--text-primary);
}

.folder-card .icon {
    display: none;
}

.folder-card .folder-name {
    font-weight: 500;
    font-size: 0.8rem;
    color: var(--text-secondary);
    transition: all 0.15s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.folder-card .folder-name::after {
    content: ' /';
    color: var(--text-muted);
    opacity: 0.3;
}

/* ===== EMPTY STATE ===== */
#empty-state {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 3rem 0;
    color: var(--text-muted);
    gap: 0.5rem;
}

#empty-state svg {
    display: none;
}

#empty-state p {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 2px;
}

#empty-state::after {
    content: '_';
    color: var(--text-primary);
    animation: blink 1s infinite;
    margin-top: 1rem;
}

/* ===== SCROLLBAR ===== */
::-webkit-scrollbar {
    width: 3px;
    height: 3px;
}

::-webkit-scrollbar-track {
    background: transparent;
}

::-webkit-scrollbar-thumb {
    background: var(--border-bright);
}

::-webkit-scrollbar-thumb:hover {
    background: var(--text-primary);
}

/* ===== ANIMATIONS ===== */
.bookmark-card, .folder-card {
    animation: slideUp 0.3s ease forwards;
    opacity: 0;
}

.bookmark-card:nth-child(1), .folder-card:nth-child(1) { animation-delay: 0.02s; }
.bookmark-card:nth-child(2), .folder-card:nth-child(2) { animation-delay: 0.04s; }
.bookmark-card:nth-child(3), .folder-card:nth-child(3) { animation-delay: 0.06s; }
.bookmark-card:nth-child(4), .folder-card:nth-child(4) { animation-delay: 0.08s; }
.bookmark-card:nth-child(5), .folder-card:nth-child(5) { animation-delay: 0.1s; }
.bookmark-card:nth-child(6), .folder-card:nth-child(6) { animation-delay: 0.12s; }
.bookmark-card:nth-child(7), .folder-card:nth-child(7) { animation-delay: 0.14s; }
.bookmark-card:nth-child(8), .folder-card:nth-child(8) { animation-delay: 0.16s; }
.bookmark-card:nth-child(9), .folder-card:nth-child(9) { animation-delay: 0.18s; }
.bookmark-card:nth-child(10), .folder-card:nth-child(10) { animation-delay: 0.2s; }
.bookmark-card:nth-child(n+11), .folder-card:nth-child(n+11) { animation-delay: 0.22s; }

/* ===== RESPONSIVE ===== */

/* Écrans standards (1080p+) */
@media (min-width: 1200px) {
    html {
        font-size: 15px;
    }

    :root {
        --sidebar-width: 300px;
    }

    .sidebar h2 {
        font-size: 0.75rem;
    }

    .folder-item {
        padding: 0.65rem 0.9rem;
        font-size: 0.85rem;
    }

    .bookmark-card {
        padding: 1rem 0;
    }

    .bookmark-title {
        font-size: 0.9rem;
    }

    .bookmark-url {
        font-size: 0.7rem;
    }

    .bookmark-icon img {
        width: 24px;
        height: 24px;
    }
}

/* Grandes résolutions (1440p+) */
@media (min-width: 1600px) {
    html {
        font-size: 16px;
    }

    :root {
        --sidebar-width: 350px;
    }

    .sidebar h2 {
        font-size: 0.8rem;
    }

    .folder-item {
        padding: 0.75rem 1rem;
        font-size: 0.9rem;
    }

    .bookmark-card {
        padding: 1.15rem 0;
    }

    .bookmark-title {
        font-size: 0.95rem;
    }

    .bookmark-url {
        font-size: 0.75rem;
    }

    .bookmark-icon img {
        width: 30px;
        height: 30px;
    }
}

/* Très grandes résolutions (4K) */
@media (min-width: 2400px) {
    html {
        font-size: 18px;
    }

    :root {
        --sidebar-width: 420px;
    }

    .sidebar h2 {
        font-size: 0.85rem;
    }

    .folder-item {
        padding: 0.85rem 1.2rem;
        font-size: 0.95rem;
    }

    .bookmark-card {
        padding: 1.3rem 0;
    }

    .bookmark-title {
        font-size: 1rem;
    }

    .bookmark-url {
        font-size: 0.8rem;
    }

    .bookmark-icon img {
        width: 36px;
        height: 36px;
    }

    header h1 {
        font-size: 1rem;
    }
}

/* Ultra-wide / 5K+ */
@media (min-width: 3200px) {
    html {
        font-size: 22px;
    }

    :root {
        --sidebar-width: 500px;
    }

    .bookmark-icon img {
        width: 42px;
        height: 42px;
    }
}

@media (max-width: 900px) {
    .sidebar {
        width: 220px;
    }

    #audio-controls {
        bottom: 1rem;
        right: 1rem;
        padding: 0.4rem 0.6rem;
    }
}

@media (max-width: 768px) {
    .container {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;
        border-right: none;
        border-bottom: 1px solid var(--border-color);
        max-height: 180px;
    }

    #search {
        width: 140px;
    }

    .bookmark-info {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.2rem;
    }

    .bookmark-title {
        min-width: auto;
    }

    #audio-controls {
        bottom: 0.5rem;
        right: 0.5rem;
        font-size: 0.6rem;
    }

    #volume-slider {
        width: 30px;
    }
}

/* ===== SELECTION ===== */
::selection {
    background: var(--text-primary);
    color: var(--bg-primary);
}

/* ===== FOCUS ===== */
:focus-visible {
    outline: 1px solid var(--text-primary);
    outline-offset: 2px;
}

/* ===== VISUALIZER ===== */
#audio-visualizer {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 40px;
    z-index: 0;
    opacity: 0.2;
    pointer-events: none;
}

/* ===== CSS FALLBACK BACKGROUND (when WebGL unavailable) ===== */
#css-fallback-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
    background: #000;
    display: none;
}

/* Perspective grid */
.grid-container {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 200%;
    height: 60%;
    perspective: 500px;
    overflow: hidden;
}

.grid-lines {
    position: absolute;
    width: 100%;
    height: 200%;
    background-image:
        linear-gradient(to right, rgba(255, 255, 255, 0.1) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
    background-size: 60px 60px;
    transform: rotateX(60deg);
    transform-origin: center top;
    animation: gridScroll 20s linear infinite;
}

@keyframes gridScroll {
    0% {
        transform: rotateX(60deg) translateY(0);
    }
    100% {
        transform: rotateX(60deg) translateY(60px);
    }
}

/* Floating particles */
.floating-particles {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.particle {
    position: absolute;
    width: 3px;
    height: 3px;
    background: #fff;
    border-radius: 50%;
    opacity: 0;
    animation: floatParticle 15s infinite;
}

.particle:nth-child(1) { left: 5%; animation-delay: 0s; animation-duration: 12s; }
.particle:nth-child(2) { left: 10%; animation-delay: 1s; animation-duration: 14s; }
.particle:nth-child(3) { left: 15%; animation-delay: 2s; animation-duration: 11s; }
.particle:nth-child(4) { left: 25%; animation-delay: 0.5s; animation-duration: 16s; }
.particle:nth-child(5) { left: 30%; animation-delay: 3s; animation-duration: 13s; }
.particle:nth-child(6) { left: 40%; animation-delay: 1.5s; animation-duration: 15s; }
.particle:nth-child(7) { left: 50%; animation-delay: 2.5s; animation-duration: 12s; }
.particle:nth-child(8) { left: 55%; animation-delay: 0.8s; animation-duration: 14s; }
.particle:nth-child(9) { left: 65%; animation-delay: 1.2s; animation-duration: 11s; }
.particle:nth-child(10) { left: 70%; animation-delay: 3.5s; animation-duration: 16s; }
.particle:nth-child(11) { left: 75%; animation-delay: 0.3s; animation-duration: 13s; }
.particle:nth-child(12) { left: 80%; animation-delay: 2.8s; animation-duration: 15s; }
.particle:nth-child(13) { left: 85%; animation-delay: 1.8s; animation-duration: 12s; }
.particle:nth-child(14) { left: 90%; animation-delay: 4s; animation-duration: 14s; }
.particle:nth-child(15) { left: 95%; animation-delay: 0.7s; animation-duration: 11s; }
.particle:nth-child(16) { left: 20%; animation-delay: 2.2s; animation-duration: 16s; }
.particle:nth-child(17) { left: 35%; animation-delay: 1.1s; animation-duration: 13s; }
.particle:nth-child(18) { left: 45%; animation-delay: 3.2s; animation-duration: 15s; }
.particle:nth-child(19) { left: 60%; animation-delay: 0.4s; animation-duration: 12s; }
.particle:nth-child(20) { left: 88%; animation-delay: 2.6s; animation-duration: 14s; }

@keyframes floatParticle {
    0% {
        transform: translateY(100vh) scale(0);
        opacity: 0;
    }
    10% {
        opacity: 0.6;
    }
    90% {
        opacity: 0.6;
    }
    100% {
        transform: translateY(-20vh) scale(1);
        opacity: 0;
    }
}

/* Vertical data lines */
.vertical-lines {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.v-line {
    position: absolute;
    width: 1px;
    height: 30%;
    background: linear-gradient(to top, transparent, rgba(255, 255, 255, 0.3), transparent);
    animation: vLineMove 8s ease-in-out infinite;
}

.v-line:nth-child(1) { left: 8%; animation-delay: 0s; height: 25%; }
.v-line:nth-child(2) { left: 18%; animation-delay: 1s; height: 35%; }
.v-line:nth-child(3) { left: 32%; animation-delay: 0.5s; height: 20%; }
.v-line:nth-child(4) { left: 45%; animation-delay: 2s; height: 40%; }
.v-line:nth-child(5) { left: 58%; animation-delay: 1.5s; height: 28%; }
.v-line:nth-child(6) { left: 72%; animation-delay: 0.8s; height: 32%; }
.v-line:nth-child(7) { left: 85%; animation-delay: 2.5s; height: 22%; }
.v-line:nth-child(8) { left: 93%; animation-delay: 1.2s; height: 38%; }

@keyframes vLineMove {
    0%, 100% {
        transform: translateY(100%);
        opacity: 0;
    }
    20% {
        opacity: 0.5;
    }
    50% {
        transform: translateY(30%);
        opacity: 0.3;
    }
    80% {
        opacity: 0.5;
    }
    100% {
        transform: translateY(-100%);
        opacity: 0;
    }
}

/* Radial vignette overlay */
#css-fallback-bg::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(
        ellipse at center,
        transparent 0%,
        transparent 40%,
        rgba(0, 0, 0, 0.6) 100%
    );
    pointer-events: none;
}

/* ==============================================
   TYPOGRAPHIE & ENVIRONNEMENT — REFINEMENTS
   ============================================== */

/* ---- SWATCH BOUTON SÉLECTEUR SELON THÈME ---- */
body:not([data-theme]) #theme-selector-btn .btn-swatch,
body[data-theme="dark"] #theme-selector-btn .btn-swatch         { background: #444; border-color: #666; opacity: 0.7; }
body[data-theme="light"] #theme-selector-btn .btn-swatch        { background: #ddd; border-color: #999; opacity: 0.8; }
body[data-theme="apple-dark"] #theme-selector-btn .btn-swatch   { background: #2997ff; border-color: #2997ff; opacity: 1; }
body[data-theme="apple-light"] #theme-selector-btn .btn-swatch  { background: #0071e3; border-color: #0071e3; opacity: 1; }
body[data-theme="nord"] #theme-selector-btn .btn-swatch         { background: #88c0d0; border-color: #88c0d0; opacity: 1; }
body[data-theme="dracula"] #theme-selector-btn .btn-swatch      { background: #ff79c6; border-color: #ff79c6; opacity: 1; }

/* ---- TRANSITION DOUCE AU CHANGEMENT DE THÈME ---- */
body { transition: background-color 0.35s ease, color 0.2s ease; }
header, .sidebar, .content,
#theme-selector-btn, #audio-controls,
#audio-toggle { transition: background-color 0.35s ease, border-color 0.3s ease, color 0.2s ease; }

/* ---- RENDU POLICE ---- */
body[data-theme^="apple"] {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}
body[data-theme="nord"],
body[data-theme="dracula"] { -webkit-font-smoothing: antialiased; }

/* ---- CANVAS BG PAR THÈME ---- */
body[data-theme="apple-dark"] #css-fallback-bg { background: #000; }
body[data-theme="nord"]       #css-fallback-bg { background: #2e3440; }
body[data-theme="dracula"]    #css-fallback-bg { background: #282a36; }
/* Opacité réduite : les lignes blanches Three.js sur fond non-noir restent lisibles */
body[data-theme="nord"]    #bg-canvas { opacity: 0.45; }
body[data-theme="dracula"] #bg-canvas { opacity: 0.35; }

/* ==============================================
   APPLE DARK & LIGHT — SUPPRESSION TERMINAL
   ============================================== */

/* Header : masquer > et _ */
body[data-theme^="apple"] header h1::before,
body[data-theme^="apple"] header h1::after { display: none; }
body[data-theme^="apple"] header h1 span {
    font-size: 1.1rem; font-weight: 600;
    letter-spacing: -0.03em; text-transform: none;
    animation: none; overflow: visible; width: auto;
}
body[data-theme^="apple"] header h1 {
    letter-spacing: -0.03em; text-transform: none;
}

/* Breadcrumb : masquer "PATH", déstyle */
body[data-theme^="apple"] #breadcrumb::before { display: none; }
body[data-theme^="apple"] #breadcrumb {
    text-transform: none; letter-spacing: 0; font-size: 0.75rem;
}
body[data-theme^="apple"] .breadcrumb-item { color: var(--accent); }
body[data-theme^="apple"] .breadcrumb-item:hover { opacity: 0.7; color: var(--accent); }

/* Masquer le header "INDEX" au-dessus de la liste */
body[data-theme^="apple"] #bookmarks-grid::before { display: none; }

/* Sidebar heading */
body[data-theme^="apple"] .sidebar h2 {
    text-transform: none; letter-spacing: 0.5px; font-size: 0.68rem; font-weight: 600;
}

/* Folder items sidebar */
body[data-theme^="apple"] .folder-item {
    text-transform: none; letter-spacing: 0; font-size: 0.83rem;
    border-left: none; border-radius: 6px; padding: 0.45rem 0.75rem;
}
body[data-theme^="apple"] .folder-item::before { display: none; }
body[data-theme^="apple"] .folder-item.has-children::after   { content: '›'; font-size: 0.9rem; color: var(--text-muted); margin-left: auto; }
body[data-theme^="apple"] .folder-item.has-children.expanded::after { content: '›'; transform: rotate(90deg); display: inline-block; }
body[data-theme^="apple"] .folder-item.active::after         { content: ''; margin-left: auto; }
body[data-theme^="apple"] .folder-item:hover,
body[data-theme^="apple"] .folder-item.active {
    background: var(--accent-dim); color: var(--accent);
    border-left: none; outline: none;
}
body[data-theme^="apple"] .folder-item.keyboard-selected {
    background: var(--accent-dim); color: var(--accent);
    border-left: none; outline: none;
}
body[data-theme^="apple"] .folder-children {
    border-left: 1px solid var(--accent-dim);
}

/* Folder name sans "/" */
body[data-theme^="apple"] .folder-name { text-transform: none; letter-spacing: 0; }
body[data-theme^="apple"] .folder-name::after { display: none; }

/* Folder cards (zone contenu) */
body[data-theme^="apple"] .folder-card {
    padding: 0.85rem 0.75rem; border-radius: 6px;
    border-bottom: none; margin-bottom: 2px;
}
body[data-theme^="apple"] .folder-card::before { display: none; }
body[data-theme^="apple"] .folder-card:hover { background: var(--accent-dim); }
body[data-theme^="apple"] .folder-card:hover .folder-name,
body[data-theme^="apple"] .folder-card:hover::after { color: var(--accent); }
body[data-theme^="apple"] .folder-name { font-size: 0.88rem; font-weight: 400; }

/* Bookmark cards */
body[data-theme^="apple"] .bookmark-card {
    padding: 0.75rem 0.5rem; transition: padding 0.15s ease, background 0.15s ease;
}
body[data-theme^="apple"] .bookmark-card::before { display: none; }
body[data-theme^="apple"] .bookmark-card:hover { padding-left: 0.75rem; }
body[data-theme^="apple"] .bookmark-card:hover::after { color: var(--accent); }
body[data-theme^="apple"] .bookmark-card:hover .bookmark-title { color: var(--accent); }
body[data-theme^="apple"] .bookmark-card.keyboard-selected {
    background: var(--accent-dim); outline: none;
}
body[data-theme^="apple"] .bookmark-card.keyboard-selected::before { display: none; }
body[data-theme^="apple"] .bookmark-card.keyboard-selected .bookmark-title { color: var(--accent); }

/* Titres et URLs */
body[data-theme^="apple"] .bookmark-title {
    text-transform: none; letter-spacing: -0.01em;
    font-size: 0.875rem; font-weight: 400;
}
body[data-theme^="apple"] .bookmark-url {
    letter-spacing: 0; color: var(--accent-secondary); opacity: 0.65;
    font-family: var(--font-mono);
}

/* Search */
body[data-theme^="apple"] #search         { border-radius: 8px; letter-spacing: 0; }
body[data-theme^="apple"] #search::placeholder { text-transform: none; letter-spacing: 0; }

/* Selector btn & panel */
body[data-theme^="apple"] #theme-selector-btn {
    border-radius: 8px; letter-spacing: 0; text-transform: none; font-size: 0.75rem;
}
body[data-theme^="apple"] .theme-panel   { border-radius: 10px; overflow: hidden; }
body[data-theme^="apple"] .theme-option  { font-size: 0.75rem; text-transform: none; letter-spacing: 0; }

/* Audio */
body[data-theme^="apple"] #audio-toggle  { border-radius: 6px; letter-spacing: 0; text-transform: none; }
body[data-theme^="apple"] #audio-controls { border-radius: 10px; }

/* Empty state */
body[data-theme^="apple"] #empty-state p       { text-transform: none; letter-spacing: 0; font-size: 0.9rem; }
body[data-theme^="apple"] #empty-state svg     { display: block; color: var(--text-muted); margin-bottom: 0.75rem; }
body[data-theme^="apple"] #empty-state::after  { display: none; }

/* Scrollbar */
body[data-theme^="apple"] ::-webkit-scrollbar-thumb       { background: rgba(0, 113, 227, 0.2); border-radius: 4px; }
body[data-theme^="apple"] ::-webkit-scrollbar-thumb:hover { background: var(--accent); }

/* ==============================================
   NORD — ACCENTS COLORÉS
   ============================================== */

body[data-theme="nord"] .folder-item:hover,
body[data-theme="nord"] .folder-item.active {
    background: rgba(136, 192, 208, 0.09); border-left-color: var(--accent); color: var(--accent);
}
body[data-theme="nord"] .folder-item.keyboard-selected {
    background: rgba(136, 192, 208, 0.12); border-left-color: var(--accent);
    outline-color: var(--accent); color: var(--accent);
}
body[data-theme="nord"] .bookmark-card:hover        { background: rgba(136, 192, 208, 0.07); }
body[data-theme="nord"] .bookmark-card:hover::before,
body[data-theme="nord"] .bookmark-card:hover .bookmark-title,
body[data-theme="nord"] .bookmark-card:hover::after { color: var(--accent); }
body[data-theme="nord"] .bookmark-card.keyboard-selected {
    background: rgba(136, 192, 208, 0.09); outline-color: var(--accent);
}
body[data-theme="nord"] :focus-visible               { outline-color: var(--accent); }
body[data-theme="nord"] ::-webkit-scrollbar-thumb        { background: rgba(136, 192, 208, 0.35); }
body[data-theme="nord"] ::-webkit-scrollbar-thumb:hover  { background: var(--accent); }

/* ==============================================
   DRACULA — ACCENTS COLORÉS
   ============================================== */

body[data-theme="dracula"] .folder-item:hover,
body[data-theme="dracula"] .folder-item.active {
    background: rgba(255, 121, 198, 0.09); border-left-color: var(--accent); color: var(--accent);
}
body[data-theme="dracula"] .folder-item.keyboard-selected {
    background: rgba(255, 121, 198, 0.12); border-left-color: var(--accent);
    outline-color: var(--accent); color: var(--accent);
}
body[data-theme="dracula"] .bookmark-card:hover        { background: rgba(255, 121, 198, 0.07); }
body[data-theme="dracula"] .bookmark-card:hover::before,
body[data-theme="dracula"] .bookmark-card:hover .bookmark-title,
body[data-theme="dracula"] .bookmark-card:hover::after { color: var(--accent); }
body[data-theme="dracula"] .bookmark-card.keyboard-selected {
    background: rgba(255, 121, 198, 0.09); outline-color: var(--accent);
}
body[data-theme="dracula"] :focus-visible              { outline-color: var(--accent); }
body[data-theme="dracula"] ::-webkit-scrollbar-thumb       { background: rgba(189, 147, 249, 0.35); }
body[data-theme="dracula"] ::-webkit-scrollbar-thumb:hover { background: var(--accent); }
